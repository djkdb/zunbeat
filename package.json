{
  "name": "beat-shift",
  "private": true,
  "version": "1.0.0",
  "description": "BEAT//SHIFT — a browser rhythm game with synthesized music, keyboard and touch play.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run src",
    "render:check": "vitest run scripts/render-check.test.ts",
    "check:charts": "vitest run src/game/songs scripts/chart-lint.test.ts"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
